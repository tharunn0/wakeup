<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_black"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/critical_setup"
                android:textColor="@color/deep_red"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_desc"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvTitle" />

            <!-- Battery Optimization -->
            <TextView
                android:id="@+id/tvBatteryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/battery_title"
                android:textColor="@color/bright_red"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvDescription" />

            <TextView
                android:id="@+id/tvBatteryDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/battery_desc"
                android:textColor="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvBatteryTitle" />

            <Button
                android:id="@+id/btnBatterySettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/dark_grey"
                android:text="@string/btn_open_battery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvBatteryDesc" />

            <!-- Exact Alarms -->
            <TextView
                android:id="@+id/tvAlarmTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/alarm_perm_title"
                android:textColor="@color/bright_red"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/btnBatterySettings" />

            <TextView
                android:id="@+id/tvAlarmDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/alarm_perm_desc"
                android:textColor="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvAlarmTitle" />

            <Button
                android:id="@+id/btnAlarmSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/dark_grey"
                android:text="@string/btn_open_alarm_settings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvAlarmDesc" />

            <!-- App Info / Notifications -->
            <TextView
                android:id="@+id/tvAppInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/overlay_title"
                android:textColor="@color/bright_red"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/btnAlarmSettings" />

            <TextView
                android:id="@+id/tvAppInfoDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/overlay_desc"
                android:textColor="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvAppInfoTitle" />

            <Button
                android:id="@+id/btnAppInfoSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/dark_grey"
                android:text="@string/btn_open_app_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/tvAppInfoDesc" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/deep_red"
                android:text="@string/btn_done"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_top_toBottomOf="@id/btnAppInfoSettings" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>